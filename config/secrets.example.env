# Copy this file to config/secrets.env and fill in your own values.
#   cp config/secrets.example.env config/secrets.env
# config/secrets.env is git-ignored and only read by docker compose on your machine.

# --- AI provider ---------------------------------------------------------------
# Fill in ONE of the keys below (or both). Leave all empty to run in demo mode
# (a simple keyword matcher is used instead of an LLM).
# If both keys are set, Anthropic is used unless AI_PROVIDER says otherwise.
#   AI_PROVIDER=anthropic | openai | demo   (optional override)
AI_PROVIDER=

# Anthropic (Claude) -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. "low" keeps the wall snappy; raise for deeper analysis.
ANTHROPIC_EFFORT=low

# OpenAI or any OpenAI-compatible API --------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: point at another OpenAI-compatible endpoint, e.g.
#   Local Ollama (docker compose --profile ollama up):  http://ollama:11434/v1
#   Ollama on your host machine:                        http://host.docker.internal:11434/v1
# Leave empty for api.openai.com.
OPENAI_BASE_URL=
# Optional sampling temperature. Leave empty for the model default.
OPENAI_TEMPERATURE=

# --- App ----------------------------------------------------------------------
# Protects /admin (seed, rebuild, delete, reset). Leave empty to disable the check.
ADMIN_TOKEN=change-me

# Public URL of the input kiosk, shown as a QR code on the wall.
# Use your machine's LAN IP so phones/tablets on the same network can reach it.
PUBLIC_INPUT_URL=http://localhost:3000/input

# Load the Dagens Medicin example statements automatically on first start (true/false).
SEED_ON_START=false
